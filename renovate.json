{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "schedule": [
    "before 6am"
  ],
  "timezone": "Europe/Amsterdam",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Debian base images: follow codename releases and pin digests so security rebuilds surface as PRs",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "debian"
      ],
      "versioning": "debian",
      "groupName": "debian base image"
    },
    {
      "description": "TShock releases: ignore pre-releases",
      "matchDepNames": [
        "Pryaxis/TShock"
      ],
      "ignoreUnstable": true
    },
    {
      "description": "GitHub Actions: keep pinned to commit SHAs, group into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "description": "Track TShock releases for ARG TSHOCK_VERSION in tshock/Dockerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tshock/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG TSHOCK_VERSION=\"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "Pryaxis/TShock",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
